# Copy to .env.local. For local backend tests use loopback only.
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-public-key
VITE_SITE_URL=http://localhost:5173
# For a demo without backend remove both Supabase variables and set VITE_DEMO=1.
# Hosted staging: VITE_APP_ENV=staging and VITE_STAGING_SUPABASE_REF=<separate-project-ref>.
